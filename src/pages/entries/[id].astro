---
import { getCollection, render } from "astro:content";
import { loadConfig } from "../../lib/config";
import { resolveCommitUrl } from "../../lib/commit-link";

export async function getStaticPaths() {
  const entries = await getCollection("entries");
  const sorted = [...entries].sort(
    (a, b) => a.data.date.getTime() - b.data.date.getTime(),
  );
  return sorted.map((entry, i) => ({
    params: { id: entry.id },
    props: {
      entry,
      prev: i > 0 ? sorted[i - 1] : undefined,
      next: i < sorted.length - 1 ? sorted[i + 1] : undefined,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const { title, date, tags, commit, commitUrl, repo, metrics, logs } = entry.data;

const config = loadConfig();
const resolvedCommitUrl = resolveCommitUrl({ commit, commitUrl, repo }, config);

function isUrl(path: string) {
  return /^https?:\/\//.test(path);
}
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | ISUCON14 tuning log</title>
    <style>
      :root {
        --bg: #ffffff;
        --fg: #1a1a1a;
        --muted: #666;
        --border: #ddd;
        --accent: #1a56db;
        --accent-bg: #eef2ff;
        --accent-fg: #3730a3;
        --code-bg: #f5f5f5;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #14161a;
          --fg: #e8e8e8;
          --muted: #9a9a9a;
          --border: #333;
          --accent: #7aa2ff;
          --accent-bg: #1b2340;
          --accent-fg: #b7c6ff;
          --code-bg: #1e2126;
        }
      }
      body {
        font-family: -apple-system, "Hiragino Kaku Gothic ProN", sans-serif;
        max-width: 760px;
        margin: 2rem auto;
        padding: 0 1rem;
        color: var(--fg);
        background: var(--bg);
        line-height: 1.7;
      }
      a {
        color: var(--accent);
      }
      a.back {
        color: var(--muted);
        font-size: 0.9rem;
      }
      .meta-panel {
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1rem;
        margin: 1rem 0 2rem;
        font-size: 0.9rem;
      }
      .meta-panel dt {
        font-weight: 600;
        color: var(--muted);
        margin-top: 0.5rem;
      }
      .meta-panel dd {
        margin: 0;
      }
      .tag {
        display: inline-block;
        background: var(--accent-bg);
        color: var(--accent-fg);
        border-radius: 4px;
        padding: 0.1rem 0.5rem;
        font-size: 0.75rem;
        margin-right: 0.25rem;
      }
      code {
        background: var(--code-bg);
        padding: 0.1rem 0.3rem;
        border-radius: 4px;
      }
      pre code {
        display: block;
        padding: 1rem;
        overflow-x: auto;
      }
      .log-item {
        margin-bottom: 0.5rem;
      }
      .log-path-row {
        display: flex;
        align-items: center;
        gap: 0.4rem;
      }
      .copy-btn {
        border: 1px solid var(--border);
        background: var(--bg);
        color: var(--muted);
        border-radius: 4px;
        font-size: 0.7rem;
        padding: 0.05rem 0.4rem;
        cursor: pointer;
      }
      .log-excerpt {
        background: var(--code-bg);
        border-radius: 4px;
        padding: 0.5rem;
        margin-top: 0.25rem;
        font-size: 0.8rem;
        overflow-x: auto;
        white-space: pre;
      }
      .prev-next {
        display: flex;
        justify-content: space-between;
        margin-top: 3rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
        font-size: 0.9rem;
      }
      .prev-next .placeholder {
        visibility: hidden;
      }
    </style>
  </head>
  <body>
    <a class="back" href={import.meta.env.BASE_URL}>← タイムラインに戻る</a>
    <h1>{title}</h1>

    <dl class="meta-panel">
      <dt>日付</dt>
      <dd>{date.toISOString().slice(0, 10)}</dd>

      {repo && (
        <>
          <dt>対象リポジトリ</dt>
          <dd>{repo}</dd>
        </>
      )}

      {commit && (
        <>
          <dt>コミット</dt>
          <dd>
            {resolvedCommitUrl ? (
              <a href={resolvedCommitUrl} target="_blank" rel="noopener noreferrer">
                <code>{commit}</code>
              </a>
            ) : (
              <code>{commit}</code>
            )}
          </dd>
        </>
      )}

      {tags.length > 0 && (
        <>
          <dt>タグ</dt>
          <dd>
            {tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </dd>
        </>
      )}

      {metrics?.before && (
        <>
          <dt>計測値(変更前)</dt>
          <dd>
            {Object.entries(metrics.before).map(([k, v]) => (
              <span>{k}: {v} </span>
            ))}
          </dd>
        </>
      )}

      {metrics?.after && (
        <>
          <dt>計測値(変更後)</dt>
          <dd>
            {Object.entries(metrics.after).map(([k, v]) => (
              <span>{k}: {v} </span>
            ))}
          </dd>
        </>
      )}

      {logs.length > 0 && (
        <>
          <dt>参照ログ</dt>
          <dd>
            <ul style="padding-left: 1.2rem; margin: 0;">
              {logs.map((log) => (
                <li class="log-item">
                  <div class="log-path-row">
                    {log.label}:
                    {isUrl(log.path) ? (
                      <a href={log.path} target="_blank" rel="noopener noreferrer">
                        <code>{log.path}</code>
                      </a>
                    ) : (
                      <>
                        <code>{log.path}</code>
                        <button class="copy-btn" data-copy-text={log.path}>
                          コピー
                        </button>
                      </>
                    )}
                  </div>
                  {log.excerpt && <pre class="log-excerpt">{log.excerpt}</pre>}
                </li>
              ))}
            </ul>
          </dd>
        </>
      )}
    </dl>

    <Content />

    <div class="prev-next">
      {prev ? (
        <a href={`${import.meta.env.BASE_URL}entries/${prev.id}/`}>← {prev.data.title}</a>
      ) : (
        <span class="placeholder">-</span>
      )}
      {next ? (
        <a href={`${import.meta.env.BASE_URL}entries/${next.id}/`}>{next.data.title} →</a>
      ) : (
        <span class="placeholder">-</span>
      )}
    </div>

    <script>
      document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const text = btn.dataset.copyText ?? "";
          await navigator.clipboard.writeText(text);
          const original = btn.textContent;
          btn.textContent = "コピーしました";
          setTimeout(() => {
            btn.textContent = original;
          }, 1500);
        });
      });
    </script>
  </body>
</html>
